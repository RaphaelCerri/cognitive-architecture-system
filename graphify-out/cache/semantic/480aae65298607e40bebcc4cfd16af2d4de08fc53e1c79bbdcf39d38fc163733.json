{"nodes": [{"id": "foundation_governance_gov_002_operating_modes_and_personal_profile", "label": "GOV-002 \u2014 Operating Modes and Personal Low-Risk Governance Profile", "file_type": "document", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Architecture Council", "contributor": null, "rationale": "Closes audit gaps G-A02 (modes undefined) and G-A14 (disproportionate governance for personal use). Contamination rule: a higher-mode requirement never enters a lower mode without recorded justification. Mode transition is a Council decision, never an implicit consequence of a feature. The profile reduces ceremony, not inherent risk (E73 \u00a76: the bottleneck is writing overhead, not the Council)."}, {"id": "foundation_governance_gov_002_operating_modes_and_personal_profile_personal_mode", "label": "Personal Mode", "file_type": "concept", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "foundation_governance_gov_002_operating_modes_and_personal_profile_team_mode", "label": "Team Mode", "file_type": "concept", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intentionally deferred; prerequisites: identity enforcement + Memory merge + concurrency (E70 \u00a710)."}, {"id": "foundation_governance_gov_002_operating_modes_and_personal_profile_product_mode", "label": "Product Mode", "file_type": "concept", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intentionally deferred; requires Team Mode plus tenancy/billing/abuse/conformance."}, {"id": "foundation_governance_gov_002_operating_modes_and_personal_profile_personal_low_risk_profile", "label": "personal-low-risk Governance Profile", "file_type": "rationale", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proportional governance for local, reversible, externally inert actions in Personal Mode: IHR-lite, self-approval with solo_operator_exception, batch CSA review, Layer-1-only return, default budgets of \u22645 files and \u22642 commits. Git discipline, stopping rules, non-compensable blockers and PMM-001 are unchanged."}, {"id": "concept_arp_0009_e70", "label": "ARP-0009-E70", "file_type": "concept", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_arp_0009_e73", "label": "ARP-0009-E73", "file_type": "concept", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_arp_0009_e74", "label": "ARP-0009-E74 (Audit Register)", "file_type": "concept", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_solo_operator_exception", "label": "solo_operator_exception", "file_type": "concept", "source_file": "foundation/governance/GOV-002-operating-modes-and-personal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "foundation_governance_gov_002_operating_modes_and_personal_profile", "target": "foundation_governance_gov_00