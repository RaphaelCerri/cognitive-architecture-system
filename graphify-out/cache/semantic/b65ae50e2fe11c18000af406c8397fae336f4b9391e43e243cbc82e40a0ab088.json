{"nodes": [{"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_arp_kmm_governed_cognitive_loops_review", "label": "ARP, Knowledge Maturity and Governed Cognitive Loops Review (DRAFT)", "file_type": "document", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": null, "source_url": null, "captured_at": "2026-07-22", "author": "Chief Execution Architect", "contributor": null}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_architectural_research", "label": "Architectural Research (ARP)", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a72-\u00a712", "source_url": null, "captured_at": null, "author": "Chief Execution Architect", "contributor": null, "rationale": "Recommended as an experimental specialization of Knowledge, not a Core Type, to fill the gap between identifying a question/technology and proposing a change without polluting the AP backlog or prematurely growing the Ontology. Lifecycle: identified\u2192scoped\u2192authorized\u2192active\u2194paused\u2192concluded, with research_form: program|case|hypothesis as a single specialization rather than three types. Research informs AP/ADR/RFC but never creates authority automatically."}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_knowledge_maturity_model", "label": "Knowledge Maturity Model (KMM)", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": "Chief Execution Architect", "contributor": null, "rationale": "Rejected as canonical workflow or type: the chain Knowledge\u2192Research\u2192AP\u2192Decision\u2192Execution\u2192Operation\u2192Evolution mixes knowledge artifacts, activities and system states with many-to-many relations. Recommended replacement: model knowledge evolution as a relational graph (Architectural Knowledge Evolution Map), not a mandatory pipeline."}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_architectural_knowledge_evolution_map", "label": "Architectural Knowledge Evolution Map", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": "Chief Execution Architect", "contributor": null, "rationale": "Provisional view proposed instead of KMM: Observation/Knowledge \u2192 optional Research \u2192 optional AP \u2192 Decision \u2192 optional RFC/Plan \u2192 Execution \u2192 Validation/Operation \u2192 Evidence \u2192 Evolution, where arrows are permitted relations, not obligations; steps may be skipped depending on risk, novelty and evidence."}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_governed_cognitive_loop", "label": "Governed Cognitive Loop", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": "Chief Execution Architect", "contributor": null, "rationale": "Treated as a contractual pattern / governance envelope over cycles, not a Core Type: explicit objective and authority, smallest useful unit per iteration, budgets (time, iterations, cost, effects), proportional validation, measurable progress, stop criteria defined before start, escalation on risk/ambiguity/authority, and Project Memory persistence without creating a parallel Source of Truth. Only becomes an object if persistent identity, composition, inspection or derived execution proves necessary."}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_bounded_execution_loop", "label": "Bounded Execution Loop", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a715", "source_url": null, "captured_at": null, "author": "Chief Execution Architect", "contributor": null, "rationale": "Classified as an operational policy and concrete example of the Governed Cognitive Loop pattern \u2014 not a Skill, not reducible to Strategy or Workflow. Its current concrete limits remain operational configuration and must not be elevated to ontological invariants."}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_agent_loop", "label": "Agent Loop", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_loop_engineering", "label": "Loop Engineering", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_human_in_the_loop", "label": "Human-in-the-Loop", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adequate for irreversibility, architecture, high risk, ambiguity and authority conflicts \u2014 the human participates directly in approval or decision."}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_human_on_the_loop", "label": "Human-on-the-Loop", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI operates within limits; the human supervises via checkpoints and gates \u2014 adequate for reversible, observable, bounded execution."}, {"id": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_cvo_csa_cea_supervision_model", "label": "CVO\u2013CSA\u2013CEA Adaptive Supervision Model", "file_type": "rationale", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": "Chief Execution Architect", "contributor": null, "rationale": "The CVO\u2013CSA\u2013CEA governance model is an adaptive combination: human-on-the-loop for limited operational autonomy, human-in-the-loop for architectural, canonical, irreversible or high-risk decisions. No dedicated name or type should be created before testing this classification."}, {"id": "concept_ap_0019", "label": "AP-0019", "file_type": "concept", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_project_memory", "label": "Project Memory", "file_type": "concept", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_pmm_001", "label": "PMM (Project Memory Mandate)", "file_type": "concept", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "\u00a722", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_rfc", "label": "RFC (Request for Comments)", "file_type": "concept", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_adr", "label": "ADR (Architecture Decision Record)", "file_type": "concept", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_graphify", "label": "Graphify", "file_type": "concept", "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_arp_kmm_governed_cognitive_loops_review", "target": "concept_architecture_council", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": "frontmatter: review_authority", "weight": 1.0}, {"source": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_arp_kmm_governed_cognitive_loops_review", "target": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_architectural_research", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": null, "weight": 1.0}, {"source": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_arp_kmm_governed_cognitive_loops_review", "target": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_knowledge_maturity_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "knowledge/assessments/DRAFT-arp-kmm-governed-cognitive-loops-review.md", "source_location": null, "weight": 1.0}, {"source": "knowledge_assessments_draft_arp_kmm_governed_cognitive_loops_review_arp_kmm_governed_cognitive_loops_review", "target": "knowledge_ass