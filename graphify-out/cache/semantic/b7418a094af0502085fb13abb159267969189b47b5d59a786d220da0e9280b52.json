{"nodes": [{"id": "foundation_directives_ad_004_architectural_research_program", "label": "AD-004 \u2014 Architectural Research Program", "file_type": "document", "source_file": "foundation/directives/AD-004-architectural-research-program.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Architecture Council", "contributor": null, "rationale": "Institutes a permanent process to study and decompose external ideas before they become change proposals; popularity is not architectural evidence. Research informs or recommends but never approves architecture, never creates normative authority, never authorizes implementation."}, {"id": "foundation_directives_ad_004_architectural_research_program_governed_cognitive_loop", "label": "Governed Cognitive Loop", "file_type": "rationale", "source_file": "foundation/directives/AD-004-architectural-research-program.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Experimental contractual pattern bounded by objective, planned context, authority, budget, useful unit, validation, progress, stopping, escalation, observability and proportional Project Memory recording. Not a Knowledge Type, Skill, Agent or mandatory Workflow."}, {"id": "foundation_directives_ad_004_architectural_research_program_bounded_execution_loop", "label": "Bounded Execution Loop", "file_type": "rationale", "source_file": "foundation/directives/AD-004-architectural-research-program.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operational policy applying the Governed Cognitive Loop pattern; its current limits are configurations, not ontological invariants."}, {"id": "foundation_directives_ad_004_architectural_research_program_context_engineering", "label": "Context Engineering (experimental strategic line)", "file_type": "concept", "source_file": "foundation/directives/AD-004-architectu